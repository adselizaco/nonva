{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nonva",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f06159ab-4d27-4f89-87a0-4b5d683710b0","database_name": "nonva" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0219d511895d4b2bbe0c4b8116c5c810" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
